# Daily local backup; copy encrypted dumps off-host as an operational task.
[Unit]
Description=Ages of Ash database backup
[Service]
Type=oneshot
User=ages-backup
Group=ages-backup
EnvironmentFile=/etc/ages/backup.env
WorkingDirectory=/srv/ages/current
ExecStart=/usr/bin/node deploy/backup.mjs
UMask=0077
NoNewPrivileges=true
