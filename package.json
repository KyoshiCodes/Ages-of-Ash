{
  "name": "ages-of-ash",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.5.1 <13"
  },
  "volta": {
    "node": "24.21.0",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "setup:db": "tsx scripts/setup-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx packages/database/src/seed.ts",
    "dev": "concurrently -k -n api,worker,web \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run tests/unit.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "build": "tsx scripts/build.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepare": "node scripts/hooks.mjs",
    "analytics": "tsx scripts/analytics.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "test:performance": "tsx scripts/check-performance.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/websocket": "^11.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.90.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "lru-cache": "^11.2.0",
    "motion": "^13.4.0",
    "pg": "^8.16.3",
    "pg-boss": "12.33.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7.9.0",
    "three": "^0.186.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.0",
    "vitest": "^3.2.0"
  }
}
