  "lore": [
    {
      "id": "first-ink",
      "title": "Receipt 001",
      "form": "ledger fragment",
      "trigger": "operations",
      "threshold": 1,
      "text": "One route secured. Three lamps extinguished. The payment arrived warm, though the courier had crossed the river in rain."
    },
    {
      "id": "witness",
      "title": "A name left intact",
      "form": "intercepted letter",
      "trigger": "audits",
      "threshold": 1,
      "text": "You could have erased her. Instead you checked the figures. I have told the others that your books still contain people."
    },
    {
      "id": "ash-one",
      "title": "The prior hand",
      "form": "audit memorandum",
      "trigger": "cycles",
      "threshold": 1,
      "text": "The new ledger bears the same indentation as the old. Someone pressed hard enough for the writing to survive the fire."
    },
    {
      "id": "network",
      "title": "Four warehouses, one key",
      "form": "ledger fragment",
      "trigger": "holdings",
      "threshold": 2,
      "text": "The key opens no door. Pass it to the next keeper anyway. A supply line is a promise made repeatedly."
    },
    {
      "id": "crew-memory",
      "title": "What Mara retained",
      "form": "intercepted letter",
      "trigger": "operations",
      "threshold": 5,
      "text": "She remembers the pause before your order. Not the crowns. Not the weather. The pause. Govern yourself accordingly."
    }
  ],
