DATABASE_URL=postgresql://ages:ages_dev_only@localhost:5432/ages?schema=public
APP_ORIGIN=http://localhost:5173
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Optional, used only by setup:db to create the app role/database. Never commit .env.
PG_ADMIN_URL=

# Retention analytics require an explicit operator decision; disabled by default.
ANALYTICS_ENABLED=false
WORKER_PORT=3001
# Required 32+ random characters in production; never a browser credential.
OPS_TOKEN=
# verify:full optionally accepts VERIFY_ADMIN_URL via the process environment only.
